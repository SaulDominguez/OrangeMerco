<script runat="server">
     /* -------------------------------------------------------------------------

     Short description of the purpose of the script.

     1. Global Variables
     1.1. Error Handling
     2. Helper Functions
     2.1. Debugging
     2.2. Error handling
     3. {{Section Name}}
     ...

     -------------------------------------------------------------------------- */

     Platform.Load('core', '1');
     // var api = new Script.Util.WSProxy();
     // Uncomment below if you will be using SOAP API via WSProxy in the script
     // var soap = new Script.Util.WSProxy();

     /* ----------------------------------------------------------------------- */
     /* ---------------------- 1. GLOBAL VARIABLES ---------------------------- */
     /* ----------------------------------------------------------------------- */

     var debugging = false;
     Variable.SetValue("@debug", debugging)

     /* -------------------- 1.1. Error Handling------------------------------- */
     var scriptName = 'AAAAAAAAAAAAAAAAAAAA';

     /* ----------------------------------------------------------------------- */
     /* ---------------------- 2. HELPER FUNCTIONS ---------------------------- */
     /* ----------------------------------------------------------------------- */

    function formatJson(json) {
     var formattedJson = TreatAsContent("\%\%=replace('" + Stringify(json) + "', ',', ',<br>')=\%\%")
     formattedJson = TreatAsContent("\%\%=replace('" + formattedJson + "', '{', '{<br>')=\%\%")
     formattedJson = TreatAsContent("\%\%=replace('" + formattedJson + "', '}', '<br>}')=\%\%")
     formattedJson = TreatAsContent("\%\%=replace('" + formattedJson + "', '[', '<br>[<br>')=\%\%")
     formattedJson = TreatAsContent("\%\%=replace('" + formattedJson + "', ']', '<br>]')=\%\%")
     return formattedJson
    }

    Array.inc = function (val, arr) {
       var ret = false;
       for (var i = 0; i < arr.length; i++) {
         if (!ret || ret == false) {
           ret = val == arr[i];
         }
       }
       return ret;
     };


     /* ---------------------- 2.1. Debugging --------------------------------- */

     /**
     * @function debugValue
     * @description Outputs provided description and SSJS value to front-end in a type-safe & consistent way
     * @param {string} description - Describes meaning of the second parameter in the output
     * @param {*} value - The value that needs to be debugged
     */
     function debugValue(description, value) {
       if (debugging) {
         Write(description + ': ' + (typeof value == 'object' ? Stringify(value) : value) + '<br><br>');
       }
     };

     function outputLink(display, url) {
       if (debugging) {
         Write("<a href='"+ url + "'>" + display + "</a>")
       }
     }

     /* ---------------------- 2.2. Error handling ---------------------------- */

     /**
     * @function handleError
     * @description Adds the error with context to error logging Data Extension and redirects to error page.
     * @param {Object} error - The caught error object. Can come from the try/catch block or be manually created.
     * @param {string} error.message - First error key stores short error message describing the issue.
     * @param {string} error.description - Second error key stores detailed error path helping with root cause analysis
     */
     function handleError(error) {
       if (debugging) {
         debugValue('Found error', error);
       }
     };

     try {
       /* ----------------------------------------------------------------------- */
       /* ----------------------- 3. {{SECTION NAME}} --------------------------- */
       /* ----------------------------------------------------------------------- */

       /**
       * There can be just one section for simpler scripts, or there can be multiple.
       * As your code grow, split it into separate numbered sections for easier navigation.
       * Always try to make each section coherent with code logic to make the split meaningful.
       */
</script>
%%[
    set @contactId = RequestParameter('Id')
    set @Email = RequestParameter('Email')
    set @nombre = Trim(ProperCase(RequestParameter('nombre')))
    set @apellidos = Trim(ProperCase(RequestParameter('apellidos')))
    set @Genero = RequestParameter('Genero')
    set @telefono = RequestParameter('telefono')
    if Length(@telefono) == 10 then
        set @telefono = Concat('52', @telefono)
    endif
    set @fechaNacimiento = RequestParameter('fechaNacimiento')
    set @Estado = RequestParameter('Estado')
    set @Ciudad = RequestParameter('Ciudad')
    set @Sucursal = RequestParameter('Sucursal')
    set @redSocial = RequestParameter('redSocial')
    set @frutasVerduras = RequestParameter('frutasVerduras')
    set @Salchichoneria = RequestParameter('Salchichonería')
    set @Carnes = RequestParameter('Carnes')
    set @Panaderia = RequestParameter('Panadería')
    set @abarrotes = RequestParameter('abarrotes')
    set @articulosBebe = RequestParameter('articulosBebe')
    set @bebidas = RequestParameter('bebidas')
    set @higieneCuidadoPersonal = RequestParameter('higieneCuidadoPersonal')
    set @MercanciasGenerales = RequestParameter('MercanciasGenerales')
    set @frecuencia = RequestParameter('frecuencia')
    set @fechaRegistro = Now()
    set @NumeroSucursal = RequestParameter('NoSucursal')
    set @rowsCorreos = LookupRows('BDD_General', 'Email', @Email)
    set @rowsTelefonos = LookupRows('BDD_General', 'Phone', @telefono)
    var @Id
    if RowCount(@rowsCorreos) >= 1 or RowCount(@rowsTelefonos) >= 1 or not Empty(@contactId) then
        if RowCount(@rowsCorreos) >= 1 then
            set @row = Row(@rowsCorreos, 1)
            set @Id = Field(@row, 'Contact_Id')
        endif
        if RowCount(@rowsTelefonos) >= 1 then
            set @row = Row(@rowsTelefonos, 1)
            set @Id = Field(@row, 'Contact_Id')
        endif
        if not Empty(@contactId) then
            set @Id = @contactId
        endif
        set @new = 0
        set @upsertCount =
            UpsertData(
                'Progressive_Profiling_3_Existentes',
                1,
                'Contact_Id',
                @Id,
                'Email',
                @Email,
                'nombre',
                @nombre,
                'apellidos',
                @apellidos,
                'Genero',
                @Genero,
                'telefono',
                @telefono,
                'fechaNacimiento',
                @fechaNacimiento,
                'Estado',
                @Estado,
                'Ciudad',
                @Ciudad,
                'Sucursal',
                @Sucursal,
                'redSocial',
                @redSocial,
                'frutasVerduras',
                @frutasVerduras,
                'Salchichoneria',
                @Salchichoneria,
                'CarnesPescados',
                @Carnes,
                'Panaderia',
                @Panaderia,
                'abarrotes',
                @abarrotes,
                'articulosBebe',
                @articulosBebe,
                'bebidas',
                @bebidas,
                'higieneCuidadoPersonal',
                @higieneCuidadoPersonal,
                'frecuencia',
                @frecuencia,
                'MercanciasGenerales',
                @MercanciasGenerales,
                'fechaRegistro',
                @fechaRegistro,
                'Locale',
                'MX',
                'NoSucursal',
                @NumeroSucursal
            )
    else
        set @new = 1
        set @Id = GUID()
        set @upsertCount =
            UpsertData(
                'Progressive_Profiling_3_Nuevos',
                1,
                'Email',
                @Email,
                'nombre',
                @nombre,
                'apellidos',
                @apellidos,
                'Genero',
                @Genero,
                'telefono',
                @telefono,
                'fechaNacimiento',
                @fechaNacimiento,
                'Estado',
                @Estado,
                'Ciudad',
                @Ciudad,
                'Sucursal',
                @Sucursal,
                'redSocial',
                @redSocial,
                'frutasVerduras',
                @frutasVerduras,
                'Salchichoneria',
                @Salchichoneria,
                'CarnesPescados',
                @Carnes,
                'Panaderia',
                @Panaderia,
                'abarrotes',
                @abarrotes,
                'articulosBebe',
                @articulosBebe,
                'bebidas',
                @bebidas,
                'higieneCuidadoPersonal',
                @higieneCuidadoPersonal,
                'frecuencia',
                @frecuencia,
                'Contact_Id',
                @Id,
                'MercanciasGenerales',
                @MercanciasGenerales,
                'fechaRegistro',
                @fechaRegistro,
                'Locale',
                'MX',
                'NoSucursal',
                @NumeroSucursal
            )
    endif
    set @upsertCount =
        UpsertData(
            'Progressive_Profiling_3_Total',
            1,
            'Contact_Id',
            @Id,
            'Email',
            @Email,
            'nombre',
            @nombre,
            'apellidos',
            @apellidos,
            'Genero',
            @Genero,
            'telefono',
            @telefono,
            'fechaNacimiento',
            @fechaNacimiento,
            'Estado',
            @Estado,
            'Ciudad',
            @Ciudad,
            'Sucursal',
            @Sucursal,
            'redSocial',
            @redSocial,
            'frutasVerduras',
            @frutasVerduras,
            'Salchichoneria',
            @Salchichoneria,
            'CarnesPescados',
            @Carnes,
            'Panaderia',
            @Panaderia,
            'abarrotes',
            @abarrotes,
            'articulosBebe',
            @articulosBebe,
            'bebidas',
            @bebidas,
            'higieneCuidadoPersonal',
            @higieneCuidadoPersonal,
            'frecuencia',
            @frecuencia,
            'MercanciasGenerales',
            @MercanciasGenerales,
            'fechaRegistro',
            @fechaRegistro,
            'Locale',
            'MX',
            'NoSucursal',
            @NumeroSucursal
        )
    UpsertData(
        'BDD_General',
        1,
        'Contact_Id',
        @Id,
        'Email',
        @Email,
        'nombre',
        @nombre,
        'Apellido',
        @apellidos,
        'Phone',
        @telefono,
        'Sucursal',
        @Sucursal,
        'fechaNacimiento',
        @fechaNacimiento,
        'Genero',
        @Genero,
        'Estado',
        @Estado,
        'Ciudad',
        @Ciudad,
        'MedioComunicacion',
        @redSocial,
        'frecuencia',
        @frecuencia,
        'Locale',
        'MX',
        'NumSucursal',
        @NumeroSucursal
    )
    if not @debug then
        Redirect('https://cloud.hello.merco.email/gracias-gana-tarjeta-merco')
    endif
]%%
<script runat="server">
    } catch (error) {
      handleError(error);
    }
</script>
